# Octane Capital Lab - example environment configuration.
# Copy this file to `.env` and fill in your own values.
# NEVER commit a real `.env` file or any real API keys.

# --- AI providers ---
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# --- Supabase (optional; the vault runs in standby mode when unset) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Research tuning ---
CONFIDENCE_THRESHOLD=8.0
SCOUT_TARGET_TICKERS=3
GHOST_MODE=false

# --- Trading safety (fail closed by default) ---
# Live trading is NOT implemented yet. These defaults keep the system in a
# research-only posture and must never be relaxed accidentally.
TRADING_MODE=research
ENABLE_LIVE_TRADING=false
REQUIRE_HUMAN_APPROVAL=true
