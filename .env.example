# ===== Octane Capital Lab — $200 swing config =====
# Copy to .env and fill in. NEVER commit .env. Rotate any key ever exposed.

# --- AI providers (optional for the swing strategy; needed for Scout/Auditor) ---
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Trading safety (live OFF by default) ---
TRADING_MODE=research
ENABLE_LIVE_TRADING=false
REQUIRE_HUMAN_APPROVAL=true

# --- Account / sizing ($200, "a little risky" but bounded) ---
STARTING_PAPER_CASH=200
MAX_POSITION_PCT=0.25            # <= 25% of equity in any one name (~$50)
MAX_SINGLE_TRADE_DOLLARS=50      # hard $ cap per trade
RISK_PER_TRADE_PCT=0.02          # ~2% of account risked to the stop (~$4)
MAX_DAILY_LOSS_PCT=0.06          # halt new entries after -6% on the day
MAX_WEEKLY_LOSS_PCT=0.12         # halt new entries after -12% on the week
MAX_OPEN_POSITIONS=4

# --- Assets (options/margin/shorts/crypto OFF for now) ---
ALLOW_OPTIONS=false
ALLOW_MARGIN=false
ALLOW_SHORTS=false
ALLOW_CRYPTO=false

# --- Swing strategy / indicators ---
ATR_PERIOD=14
ATR_STOP_MULT=1.5                # stop = 1.5x ATR below entry
RSI_PERIOD=14
SWING_MIN_SCORE=7.0              # min composite score to propose
SWING_MIN_HOLD_DAYS=3
SWING_MAX_HOLD_DAYS=30

# --- Quality screen (no junk) ---
MIN_PRICE=5
MIN_AVG_DOLLAR_VOLUME=20000000   # $20M/day liquidity floor
MIN_MARKET_CAP=2000000000        # $2B market-cap floor
EARNINGS_BLACKOUT_DAYS=3

WATCHLIST=NVDA,AMD,TSM,AVGO,MSFT,GOOGL,META,AMZN,PLTR,ARM

# --- Robinhood MCP ---
ROBINHOOD_MCP_SERVER=https://agent.robinhood.com/mcp/trading
